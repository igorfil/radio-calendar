{
  "name": "radio-calendar",
  "version": "0.1.0",
  "description": "A day-view calendar web component styled like a vintage radio tuner dial, with meetings as pieces of colored glass.",
  "keywords": [
    "calendar",
    "web-component",
    "custom-element",
    "day-view",
    "timeline",
    "react"
  ],
  "author": "Igor Fil <igor.v.fil@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorfil/radio-calendar.git"
  },
  "homepage": "https://igorfil.github.io/radio-calendar/",
  "bugs": "https://github.com/igorfil/radio-calendar/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
